        from_json(json(
        {{ operation.ActualOperationName }}({% for parameter in operation.Parameters %}{% if parameter.IsBool %}sys.diutil.bool_to_int({{ parameter.VariableName }}){% else %}{{ parameter.VariableName }}{% endif%} {% if parameter.IsLast == false %}, {% endif %}{% endfor %})).to_json_value(),
