{% if IsNotEnumeration -%}
function get_json(v_model {{ClassName}}) return json as
     v_json json := json(); 
   begin
    if v_model.m_isNull then
        return null;
    end if;
{% for property in AllProperties -%}
{% if(property.IsComplex) -%}
     v_json.put('{{property.JsonName}}', get_json(v_model.{{property.FieldName}})); -- {{property.Type}} 
{% else -%}
    putj(v_json, '{{property.JsonName}}', v_model.{{property.FieldName}});
{% endif -%}
{% endfor -%}
     return v_json;
   end;  

function get_json(v_list {{ClassName}}T) return json_list as
        v_json_list json_list := json_list();
    begin
        if v_list is null then
            return null;
        end if;
        if v_list.first is not null then
            for i in v_list.first .. v_list.last loop
                v_json_list.append( get_json(v_list(i)).to_json_value() );
            end loop;  
        end if;
        return v_json_list;
    end;

procedure from_json(pi_data json_value, po_data in out {{ClassName}} ) as
		j json;
	begin
        if pi_data is not null then
            po_data.m_isNull := false;
            j := json(pi_data);
{% for property in AllProperties -%}
            if j.exist('{{property.JsonName}}') and not j.get('{{property.JsonName}}').is_null() then
{%    if(property.IsComplex) -%}
                -- {{property.Type}} 
                from_json(j.get('{{property.JsonName}}'), po_data.{{property.FieldName}});
{% else -%}
{% case property.Type -%}
  {% when "VARCHAR2(1024)" -%}
                po_data.{{property.FieldName}} := j.get('{{property.JsonName}}').get_string();
  {% when "PLS_INTEGER" -%}
                po_data.{{property.FieldName}} := j.get('{{property.JsonName}}').get_number();
  {% when "RAW(16)" -%}
                po_data.{{property.FieldName}} := replace(j.get('{{property.JsonName}}').get_string(),'-','');
  {% when "boolean" -%}
                po_data.{{property.FieldName}} := j.get('{{property.JsonName}}').get_bool();        
  {% when "clob" -%}
                po_data.{{property.FieldName}} := j.get('{{property.JsonName}}').to_char();
  {% when "Date" -%}
                po_data.{{property.FieldName}} := cast( to_timestamp(j.get('{{property.JsonName}}').get_string(), c_tsf) as date );
  {% else %}
    {%    if(property.IsString) -%}
                po_data.{{property.FieldName}} := j.get('{{property.JsonName}}').get_string(); -- {{property.Type}}
    {% else %}
                null; -- {{property.Type}}
    {% endif -%}
  {% endcase -%}
{% endif -%}
            end if;
{% endfor -%}
        end if;
    end;  
procedure from_json(pi_data json_value, po_data in out {{ClassName}}T ) as 
     v_json_list json_list;
  begin
	 v_json_list := json_list(pi_data);
     po_data := new {{ClassName}}T();
     po_data.extend(v_json_list.count);
     for i in 1 .. v_json_list.count loop
       from_json(v_json_list.get(i), po_data(i));
     end loop;  
     return;
   end;  
{% endif -%}